---
/**
 * Today — the wire.
 *
 * Sections, in reading order:
 *   1. Hero: the newest lead, plus a panel of everything filed in this update window.
 *   2. The brief: today's stories in one filterable list (topic filter is remembered).
 *   3. Topics: four sections, each carrying its own latest stories, not links to a list.
 *   4. Earlier: what was filed before today, then the archive link.
 *
 * There are no editions anywhere on this page. Time is a stamp on a story, not a section.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Kicker from '../components/Kicker.astro';
import SectionHead from '../components/SectionHead.astro';
import { CHANNEL_LIST, CHANNELS, SITE, UPDATE_COPY } from '../lib/site';
import { fmtDate, fmtStamp, fmtTime, isoDay, pad, relTime } from '../lib/format';

const stories = (await getCollection('stories'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const todayKey = isoDay(new Date());
const todays = stories.filter((entry) => isoDay(entry.data.publishedAt) === todayKey);
const brief = todays.length > 0 ? todays : stories.slice(0, 6);
const briefDay = brief[0] ? isoDay(brief[0].data.publishedAt) : todayKey;
const isToday = briefDay === todayKey;

const lead = todays.find((entry) => entry.data.lead) ?? todays[0] ?? stories[0];
const wire = brief.slice(0, 7);
const earlier = stories.filter((entry) => !brief.includes(entry)).slice(0, 5);

const sourceCount = new Set(brief.flatMap((entry) => entry.data.sources.map((source) => source.url))).size;
const lastUpdated = stories[0]?.data.updatedAt ?? stories[0]?.data.publishedAt;
const firstFiled = stories[stories.length - 1]?.data.publishedAt;

const topics = CHANNEL_LIST.map((channel) => {
  const inTopic = stories.filter((entry) => entry.data.channel === channel.slug);
  return {
    ...channel,
    total: inTopic.length,
    latest: inTopic.slice(0, 3),
    fresh: inTopic.filter((entry) => isoDay(entry.data.publishedAt) === todayKey).length,
  };
});

const totals = {
  stories: stories.length,
  sources: new Set(stories.flatMap((entry) => entry.data.sources.map((source) => source.url))).size,
  topics: new Set(stories.map((entry) => entry.data.channel)).size,
};

const firstBlock = (lead?.body ?? '')
  .trim()
  .split(/\n{2,}/)
  .find((block) => {
    const line = block.trim();
    return (
      line.length > 0 &&
      !line.startsWith('#') &&
      !line.startsWith('>') &&
      !line.startsWith('-') &&
      !line.startsWith('|') &&
      !line.startsWith('```')
    );
  });
const leadExcerpt = (firstBlock ?? '')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/[*_`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'en-IN',
  publisher: { '@type': 'Organization', name: SITE.owner, url: SITE.url },
};
---

<Base title={SITE.title} description={SITE.description} schema={schema}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="dateline">
          <span>{isToday ? 'Today' : 'Last filed'}, {fmtDate(briefDay)}</span>
          <span>{brief.length} {brief.length === 1 ? 'story' : 'stories'}{isToday ? ' so far' : ''}</span>
        </p>

        <h1 class={lead ? 'hero__title hero__title--story' : 'hero__title'}>
          {lead ? lead.data.title : 'The AI wire that cites its sources.'}
        </h1>

        <p class="lede">{lead ? lead.data.dek : SITE.tagline}</p>

        {lead && (
          <p class="hero__meta">
            <span>{CHANNELS[lead.data.channel].label}</span>
            <span>{lead.data.readingTime} min read</span>
            <span>{lead.data.sources.length} sources</span>
            <span>{relTime(lead.data.publishedAt)}</span>
          </p>
        )}

        <div class="hero__actions">
          {lead ? (
            <a class="btn btn--primary" href={`/story/${lead.id}`}>
              Read the lead story
            </a>
          ) : (
            <a class="btn btn--primary" href="/latest">
              Open the archive
            </a>
          )}
          {earlier.length > 0 && (
            <a class="link-arrow" href="#earlier">
              Earlier stories
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>

      <aside class="wire" aria-labelledby="wire-heading">
        <div class="wire__head">
          <h2 id="wire-heading" class="wire__title">The wire</h2>
          <span class="wire__stamp">
            {lastUpdated ? `Updated ${fmtTime(lastUpdated)} IST` : 'Desk open'}
          </span>
        </div>

        {wire.length === 0 ? (
          <p class="wire__empty">Nothing filed yet. The first check runs at 06:00 IST.</p>
        ) : (
          <ol class="wire__list">
            {wire.map((entry) => (
              <li class:list={['wire__item', { 'is-lead': entry === lead }]}>
                <a href={`/story/${entry.id}`}>
                  <span class="wire__time">
                    <time datetime={entry.data.publishedAt.toISOString()}>{fmtTime(entry.data.publishedAt)}</time>
                    <span class="wire__channel">{CHANNELS[entry.data.channel].short}</span>
                  </span>
                  <span class="wire__headline">{entry.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        )}

        <p class="wire__foot">
          {isToday ? 'Filed today' : `Filed ${fmtDate(briefDay)}`} · {sourceCount} sources linked · {UPDATE_COPY}
        </p>
      </aside>
    </div>
  </section>

  <section class="section section--tight" id="brief" aria-labelledby="brief-heading">
    <div class="container">
      <SectionHead
        title={isToday ? "Today's brief" : `The brief · ${fmtDate(briefDay)}`}
        id="brief-heading"
        action={{ href: '/latest', label: 'Everything filed' }}
      />

      <div class="filters" role="group" aria-label="Filter the brief by topic" data-filters>
        <button type="button" class="filter is-on" data-filter="all" aria-pressed="true">All topics</button>
        {CHANNEL_LIST.map((channel) => (
          <button type="button" class="filter" data-filter={channel.slug} aria-pressed="false">
            {channel.short}
            <span class="filter__count">
              {brief.filter((entry) => entry.data.channel === channel.slug).length}
            </span>
          </button>
        ))}
      </div>

      {brief.length === 0 ? (
        <p class="empty-note">No stories on file yet. The first check runs at 06:00 IST.</p>
      ) : (
        <ol class="brief" data-brief>
          {brief.map((entry, index) => (
            <li class="brief__row" data-channel={entry.data.channel} data-reveal style={`--i:${index}`}>
              <a href={`/story/${entry.id}`}>
                <span class="brief__index" aria-hidden="true">{pad(index + 1)}</span>
                <span class="brief__main">
                  <span class="brief__top">
                    <span class="chip chip--line">{CHANNELS[entry.data.channel].short}</span>
                    <span class="brief__title">{entry.data.title}</span>
                  </span>
                  <span class="brief__dek">{entry.data.dek}</span>
                </span>
                <span class="brief__meta">
                  <time datetime={entry.data.publishedAt.toISOString()}>{fmtTime(entry.data.publishedAt)} IST</time>
                  <span>{entry.data.readingTime} min</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )}

      <p class="brief__empty-filter" data-empty-filter hidden>Nothing filed under that topic in this brief.</p>
    </div>
  </section>

  <section class="section topics" id="topics" aria-labelledby="topics-heading">
    <div class="container">
      <SectionHead title="By topic" id="topics-heading" label="The latest in each" />

      <div class="topic-grid">
        {topics.map((topic, index) => (
          <section class="topic" aria-labelledby={`topic-${topic.slug}`} data-reveal style={`--i:${index}`}>
            <header class="topic__head">
              <h3 id={`topic-${topic.slug}`}>
                <a href={`/channel/${topic.slug}`}>{topic.label}</a>
              </h3>
              <p class="topic__blurb">{topic.blurb}</p>
              <p class="topic__count">
                {topic.total} {topic.total === 1 ? 'story' : 'stories'}
                {topic.fresh > 0 && <span class="topic__fresh"> · {topic.fresh} today</span>}
              </p>
            </header>

            {topic.latest.length === 0 ? (
              <p class="topic__empty">Nothing filed here yet.</p>
            ) : (
              <ol class="topic__list">
                {topic.latest.map((entry) => (
                  <li>
                    <a href={`/story/${entry.id}`}>
                      <span class="topic__title">{entry.data.title}</span>
                      <span class="topic__time">
                        {fmtDate(entry.data.publishedAt)} · {entry.data.readingTime} min
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )}

            <a class="link-arrow topic__more" href={`/channel/${topic.slug}`}>
              All {topic.short}
              <span aria-hidden="true">→</span>
            </a>
          </section>
        ))}
      </div>
    </div>
  </section>

  {earlier.length > 0 && (
    <section class="section section--tight earlier" id="earlier" aria-labelledby="earlier-heading">
      <div class="container">
        <SectionHead title="Earlier" id="earlier-heading" label="Before this brief" />

        <ol class="earlier__list">
          {earlier.map((entry) => (
            <li class="earlier__row">
              <a href={`/story/${entry.id}`}>
                <span class="earlier__date">{fmtDate(entry.data.publishedAt)}</span>
                <span class="earlier__title">{entry.data.title}</span>
                <span class="earlier__topic">{CHANNELS[entry.data.channel].short}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section archive-band" aria-labelledby="archive-heading">
    <div class="container archive-band__inner">
      <div>
        <h2 id="archive-heading">{totals.stories} stories on file.</h2>
        <p class="archive-band__copy">
          {totals.sources} sources linked across {totals.topics} topics, the first filed
          {' '}{firstFiled ? fmtDate(firstFiled) : 'today'}. Every story stays in the archive with its
          sources attached.
        </p>
      </div>
      <div class="archive-band__actions">
        <a class="btn btn--primary" href="/latest">Open the archive</a>
        <a class="link-arrow" href="/rss.xml">
          RSS
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    position: relative;
    overflow: clip;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -10% -10% auto;
    height: 90%;
    background: radial-gradient(58% 62% at 68% 32%, var(--wash) 0%, transparent 72%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
    padding-block: clamp(36px, 6vw, 88px) clamp(40px, 6vw, 80px);
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .dateline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__copy h1 {
    max-width: 18ch;
  }

  .hero__title--story {
    font-size: clamp(32px, 3.15vw + 8px, 58px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    max-width: none;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding-top: var(--space-2);
  }

  /* ---------- the wire ---------- */

  .wire {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }

  .wire__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .wire__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .wire__stamp {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .wire__list {
    display: grid;
    gap: 0;
  }

  .wire__item + .wire__item {
    border-top: 1px solid var(--line-soft);
  }

  .wire__item a {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    padding-block: 12px;
    min-height: 44px;
    transition: background-color var(--duration) var(--ease);
  }

  .wire__item a:hover {
    background: color-mix(in srgb, var(--paper-band) 55%, transparent);
  }

  .wire__time {
    display: grid;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  .wire__channel {
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .wire__headline {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .wire__item.is-lead .wire__headline {
    font-weight: 500;
  }

  .wire__item a:hover .wire__headline {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .wire__foot,
  .wire__empty {
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    line-height: 1.6;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ---------- filters ---------- */

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: var(--space-4);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .filter:hover {
    border-color: var(--ink-mute);
    color: var(--ink);
  }

  .filter.is-on {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .filter__count {
    font-size: var(--text-micro);
    opacity: 0.65;
  }

  /* ---------- brief ---------- */

  .brief {
    border-top: 1px solid var(--line);
  }

  .brief__row {
    border-bottom: 1px solid var(--line);
  }

  .brief__row[hidden] {
    display: none;
  }

  .brief__row a {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 120px;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    transition: background-color var(--duration) var(--ease);
  }

  .brief__row a:hover {
    background: color-mix(in srgb, var(--paper-band) 60%, transparent);
  }

  .brief__index {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    padding-top: 5px;
  }

  .brief__main {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .brief__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .brief__title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.35vw + 1.05rem, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: break-word;
    min-width: 0;
  }

  .brief__row a:hover .brief__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .brief__dek {
    max-width: 62ch;
    font-size: var(--text-ui);
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .brief__meta {
    display: grid;
    justify-items: end;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 3px;
    text-align: right;
  }

  .brief__empty-filter {
    padding-block: var(--space-6);
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---------- topics ---------- */

  .topics {
    background: var(--paper-band);
    border-block: 1px solid var(--line);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .topic {
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(20px, 2.4vw, 32px);
    background: var(--paper);
  }

  .topic__head {
    display: grid;
    gap: 6px;
  }

  .topic__head h3 {
    margin: 0;
    font-size: clamp(1.35rem, 0.8vw + 1.2rem, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .topic__head h3 a {
    transition: color var(--duration) var(--ease);
  }

  .topic__head h3 a:hover {
    color: var(--accent);
  }

  .topic__blurb {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-ui);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .topic__count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .topic__fresh {
    color: var(--sage-deep);
  }

  .topic__list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .topic__list li {
    border-bottom: 1px solid var(--line-soft);
  }

  .topic__list a {
    display: grid;
    gap: 4px;
    padding-block: 12px;
    min-height: 44px;
  }

  .topic__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .topic__list a:hover .topic__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .topic__time {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .topic__empty {
    margin: 0;
    padding-block: var(--space-4);
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .topic__more {
    justify-self: start;
  }

  /* ---------- earlier ---------- */

  .earlier {
    padding-top: clamp(40px, 5vw, 64px);
  }

  .earlier__list {
    border-top: 1px solid var(--line);
  }

  .earlier__row {
    border-bottom: 1px solid var(--line);
  }

  .earlier__row a {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 60px;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    transition: background-color var(--duration) var(--ease);
  }

  .earlier__row a:hover {
    background: color-mix(in srgb, var(--paper-band) 60%, transparent);
  }

  .earlier__date,
  .earlier__topic {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .earlier__topic {
    text-align: right;
  }

  .earlier__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .earlier__row a:hover .earlier__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ---------- archive band ---------- */

  .archive-band {
    background: var(--paper-deep);
    border-top: 1px solid var(--line);
  }

  .archive-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .archive-band h2 {
    margin: 0;
    font-size: clamp(1.75rem, 2vw + 1rem, 2.75rem);
    font-variant-numeric: tabular-nums;
  }

  .archive-band__copy {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font-size: var(--text-ui);
  }

  .archive-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  /* ---------- responsive ---------- */

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .topic-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .brief__row a {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .brief__meta {
      grid-column: 2;
      justify-items: start;
      display: flex;
      gap: 12px;
      padding-top: 0;
    }

    .earlier__row a {
      grid-template-columns: minmax(0, 1fr) 52px;
      gap: var(--space-2) var(--space-3);
    }

    .earlier__date {
      grid-column: 1 / -1;
    }

    .wire__item a {
      grid-template-columns: 64px minmax(0, 1fr);
    }
  }
</style>

<script>
  const KEY = 'og-brief-filter';
  const CHANNELS = ['ai', 'llm', 'ml', 'technology'];

  const initFilters = () => {
    const group = document.querySelector<HTMLElement>('[data-filters]');
    const list = document.querySelector<HTMLElement>('[data-brief]');
    if (!group || !list) return;

    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-channel]'));
    const empty = document.querySelector<HTMLElement>('[data-empty-filter]');

    let current = 'all';
    try {
      const stored = localStorage.getItem(KEY);
      if (stored === 'all' || (stored && CHANNELS.includes(stored))) current = stored;
    } catch {
      /* storage blocked: the filter still works for this visit */
    }

    const apply = (value: string) => {
      current = value;
      buttons.forEach((button) => {
        const on = button.dataset.filter === value;
        button.classList.toggle('is-on', on);
        button.setAttribute('aria-pressed', String(on));
      });

      let shown = 0;
      rows.forEach((row) => {
        const match = value === 'all' || row.dataset.channel === value;
        row.hidden = !match;
        if (match) shown += 1;
      });

      if (empty) empty.hidden = shown > 0;

      try {
        localStorage.setItem(KEY, value);
      } catch {
        /* ignore */
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
    });

    apply(current);
  };

  document.addEventListener('astro:page-load', initFilters);
  if (document.readyState !== 'loading') initFilters();
  else document.addEventListener('DOMContentLoaded', initFilters);
</script>
