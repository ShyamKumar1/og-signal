---
/**
 * Search — Pagefind UI mounted into the system's card surface.
 * The index is generated by `npm run build` (pagefind --site dist); dev sessions
 * therefore show a note until the site has been built once.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Kicker from '../components/Kicker.astro';
import { CHANNEL_LIST, SITE } from '../lib/site';

const storyCount = (await getCollection('stories')).filter((entry) => !entry.data.draft).length;
---

<Base title="Search" description={`Search every story filed by ${SITE.title}.`}>
  <section class="search">
    <div class="container">
      <header class="page-head">
        <Kicker label="Search" text={`${storyCount} ${storyCount === 1 ? 'story' : 'stories'} indexed`} />
        <h1>Find a story.</h1>
        <p class="lede">
          Search the full text of every filed story, including the sources each one cites. Results
          are ordered by relevance.
        </p>
      </header>

      <div class="search-shell card" data-search-root></div>

      <p class="search-note" data-search-note hidden>
        The search index is generated at build time, so it is not available in a development
        session. Run <code>npm run build</code> to generate it, then reload this page.
      </p>

      <p class="page-head__meta search-foot">
        <span>Prefer to browse?</span>
        <a href="/latest">Latest stories</a>
        {CHANNEL_LIST.map((channel) => (
          <a href={`/channel/${channel.slug}`}>{channel.short}</a>
        ))}
      </p>
    </div>
  </section>
</Base>

<script>
  interface PagefindUIOptions {
    element: HTMLElement | string;
    showImages?: boolean;
    showSubResults?: boolean;
    autofocus?: boolean;
    translations?: Record<string, string>;
  }

  interface PagefindUIInstance {
    triggerSearch(term: string): void;
  }

  type PagefindUIConstructor = new (options: PagefindUIOptions) => PagefindUIInstance;

  type PagefindWindow = Window & { PagefindUI?: PagefindUIConstructor };

  const pfWindow = window as PagefindWindow;

  let loader: Promise<boolean> | null = null;

  const loadCss = (): Promise<boolean> =>
    new Promise((resolve) => {
      if (document.querySelector('link[data-pagefind-ui]')) return resolve(true);
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '/pagefind/pagefind-ui.css';
      link.dataset.pagefindUi = '';
      link.addEventListener('load', () => resolve(true));
      link.addEventListener('error', () => resolve(false));
      document.head.append(link);
    });

  const loadJs = (): Promise<boolean> =>
    new Promise((resolve) => {
      if (pfWindow.PagefindUI) return resolve(true);
      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.dataset.pagefindUi = '';
      script.addEventListener('load', () => resolve(Boolean(pfWindow.PagefindUI)));
      script.addEventListener('error', () => resolve(false));
      document.head.append(script);
    });

  const loadUi = (): Promise<boolean> => {
    if (!loader) {
      loader = Promise.all([loadCss(), loadJs()]).then(
        ([cssOk, jsOk]) => cssOk && jsOk && Boolean(pfWindow.PagefindUI),
      );
    }
    return loader;
  };

  const mount = async () => {
    const root = document.querySelector<HTMLElement>('[data-search-root]');
    const note = document.querySelector<HTMLElement>('[data-search-note]');
    if (!root || root.dataset.mounted === 'true') return;

    const available = await loadUi();
    const PagefindUI = pfWindow.PagefindUI;
    if (!available || !PagefindUI) {
      note?.removeAttribute('hidden');
      return;
    }

    root.dataset.mounted = 'true';
    const ui = new PagefindUI({
      element: root,
      showImages: false,
      showSubResults: true,
      translations: { placeholder: 'Search stories and sources' },
    });

    const query = new URLSearchParams(window.location.search).get('q');
    if (query) ui.triggerSearch(query);
  };

  document.addEventListener('astro:page-load', mount);
  if (document.readyState !== 'loading') mount();
  else document.addEventListener('DOMContentLoaded', mount);
</script>

<style>
  .search {
    padding-bottom: var(--section-y);
  }

  .search-shell {
    padding: clamp(16px, 2.4vw, 28px);
    background: var(--card);
  }

  .search-shell :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink-soft);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--paper-band);
    --pagefind-ui-border-radius: var(--radius-card);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-font: var(--font-body);
  }

  .search-shell :global(.pagefind-ui__search-input) {
    min-height: 52px;
    padding-inline: 20px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .search-shell :global(.pagefind-ui__search-clear) {
    padding-inline: 12px;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-shell :global(.pagefind-ui__message) {
    padding-block: 20px;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-shell :global(.pagefind-ui__result) {
    padding: 18px 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
  }

  .search-shell :global(.pagefind-ui__result-title),
  .search-shell :global(.pagefind-ui__result-link) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-decoration: none;
  }

  .search-shell :global(.pagefind-ui__result-link:hover) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .search-shell :global(.pagefind-ui__result-excerpt) {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .search-shell :global(.pagefind-ui mark) {
    background: var(--paper-deep);
    color: var(--ink);
  }

  .search-shell :global(.pagefind-ui__button) {
    min-height: 44px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .search-note {
    max-width: 62ch;
    padding: var(--space-5);
    margin-top: var(--space-4);
    border: 1px dashed var(--line);
    border-radius: var(--radius-inner);
    color: var(--ink-soft);
    font-size: var(--text-ui);
    line-height: 1.6;
  }

  .search-note code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--paper-deep);
    padding: 0.12em 0.35em;
    border-radius: 4px;
  }

  .search-foot {
    align-items: center;
    padding-top: var(--space-5);
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .search-foot a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-bottom: 1px solid var(--line);
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .search-foot a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
