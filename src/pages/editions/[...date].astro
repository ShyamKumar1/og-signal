---
/**
 * Legacy /editions routes.
 * Editions no longer exist on this site; any old link lands here and is sent to
 * the archive. Rendered as a plain meta refresh so it works on static output.
 */
import { getCollection } from 'astro:content';
import { isoDay } from '../../lib/format';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  const days = [...new Set(stories.map((story) => isoDay(story.data.publishedAt)))];
  return [
    { params: { date: undefined } },
    ...days.map((day) => ({ params: { date: day } })),
  ];
}

const target = '/latest';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0; url=/latest" />
    <link rel="canonical" href="https://og-signal.netlify.app/latest" />
    <title>Moved · OG Signal</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f7f8f1;
        color: #14170f;
        font-family: ui-sans-serif, system-ui, sans-serif;
      }
      main {
        text-align: center;
        padding: 24px;
      }
      a {
        color: #b65916;
      }
    </style>
  </head>
  <body>
    <main>
      <p>Editions were retired.</p>
      <p><a href={target}>Continue to the archive</a></p>
    </main>
  </body>
</html>
