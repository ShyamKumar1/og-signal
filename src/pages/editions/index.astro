---
/**
 * Editions archive — every filing day, newest first.
 * Each row links to /editions/<isoDay>; nothing is capped.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import SectionHead from '../../components/SectionHead.astro';
import Chip from '../../components/Chip.astro';
import { EDITION_ORDER, EDITIONS, SITE } from '../../lib/site';
import { fmtDate, fmtTime, isoDay } from '../../lib/format';

type Story = CollectionEntry<'stories'>;

const stories = (await getCollection('stories'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const byDay = new Map<string, Story[]>();
for (const story of stories) {
  const day = isoDay(story.data.publishedAt);
  const list = byDay.get(day);
  if (list) list.push(story);
  else byDay.set(day, [story]);
}

const days = [...byDay.entries()].map(([day, entries]) => ({
  day,
  entries,
  lead: entries.find((entry) => entry.data.lead) ?? entries[0],
  editions: EDITION_ORDER.filter((edition) => entries.some((entry) => entry.data.edition === edition)),
  filedAt: entries[0].data.publishedAt,
}));

const sourceCount = new Set(stories.flatMap((entry) => entry.data.sources.map((source) => source.url))).size;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Editions · ${SITE.title}`,
  url: new URL(Astro.url.pathname, SITE.url).href,
  description: `Every filing day on ${SITE.title}.`,
  isPartOf: { '@type': 'WebSite', name: SITE.title, url: SITE.url },
};
---

<Base
  title="Editions"
  description={`Every filing day on ${SITE.title}, newest first.`}
  schema={schema}
>
  <section class="archive">
    <div class="container">
      <header class="page-head">
        <Kicker label="Archive" text={`${days.length} ${days.length === 1 ? 'day' : 'days'} on file`} />
        <h1>Every edition, in order.</h1>
        <p class="lede">
          The full filing history, newest day first. Each day lists the editions that filed, the
          story count and the lead headline.
        </p>
        <p class="page-head__meta">
          <span>{stories.length} stories</span>
          <span>{sourceCount} sources linked</span>
          <span>All times IST</span>
        </p>
      </header>

      <SectionHead
        title="Filing days"
        label="Newest first"
        action={stories.length > 0 ? { href: '/rss.xml', label: 'Subscribe' } : undefined}
      />

      {days.length === 0 ? (
        <p class="empty-note">No editions filed yet.</p>
      ) : (
        <ol class="rows">
          {days.map((day, index) => (
            <li class="day-row" data-reveal style={`--i:${index}`}>
              <a href={`/editions/${day.day}`}>
                <span class="day-row__date">{fmtDate(day.day)}</span>

                <span class="day-row__main">
                  <span class="day-row__chips">
                    {day.editions.map((edition) => (
                      <Chip label={EDITIONS[edition].label.replace(' Edition', '')} />
                    ))}
                  </span>
                  <span class="day-row__title">{day.lead.data.title}</span>
                </span>

                <span class="day-row__meta">
                  <span>
                    {day.entries.length} {day.entries.length === 1 ? 'story' : 'stories'}
                  </span>
                  <span>Filed {fmtTime(day.filedAt)} IST</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>
</Base>

<style>
  .archive {
    padding-bottom: var(--section-y);
  }

  .day-row a {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 170px;
    gap: var(--space-5);
    align-items: baseline;
    padding-block: var(--space-5);
    transition: background-color var(--duration) var(--ease);
  }

  .day-row a:hover {
    background: color-mix(in srgb, var(--paper-band) 60%, transparent);
  }

  .day-row__date {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .day-row__main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .day-row__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .day-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.35vw + 1.05rem, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .day-row a:hover .day-row__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .day-row__meta {
    display: grid;
    justify-items: end;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-align: right;
  }

  @media (max-width: 720px) {
    .day-row a {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .day-row__meta {
      justify-items: start;
      display: flex;
      gap: 14px;
      text-align: left;
    }
  }
</style>
