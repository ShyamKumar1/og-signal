---
/**
 * One filing day — its lead story, then every story grouped by edition.
 * Static paths over distinct isoDay values; prev/next day links where they exist.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Kicker from '../../components/Kicker.astro';
import SectionHead from '../../components/SectionHead.astro';
import StoryRow from '../../components/StoryRow.astro';
import { CHANNELS, EDITION_ORDER, EDITIONS, SITE, type EditionSlug } from '../../lib/site';
import { fmtDate, fmtTime, isoDay } from '../../lib/format';

type Story = CollectionEntry<'stories'>;

export async function getStaticPaths() {
  const stories = (await getCollection('stories'))
    .filter((entry) => !entry.data.draft)
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

  const byDay = new Map<string, Story[]>();
  for (const story of stories) {
    const day = isoDay(story.data.publishedAt);
    const list = byDay.get(day);
    if (list) list.push(story);
    else byDay.set(day, [story]);
  }

  return [...byDay.entries()].map(([day, entries]) => ({
    params: { date: day },
    props: { day, entries },
  }));
}

interface Props {
  day: string;
  entries: Story[];
}

const { day, entries } = Astro.props;

const lead = entries.find((entry) => entry.data.lead) ?? entries[0];
const sourceCount = new Set(entries.flatMap((entry) => entry.data.sources.map((source) => source.url))).size;
const channelCount = new Set(entries.map((entry) => entry.data.channel)).size;

const allStories = (await getCollection('stories'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const allDays = [...new Set(allStories.map((entry) => isoDay(entry.data.publishedAt)))].sort().reverse();
const index = allDays.indexOf(day);
const older = index >= 0 ? allDays[index + 1] : undefined;
const newer = index > 0 ? allDays[index - 1] : undefined;

const groups = EDITION_ORDER.map((edition: EditionSlug) => ({
  slug: edition,
  ...EDITIONS[edition],
  stories: entries.filter((entry) => entry.data.edition === edition),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Editions · ${fmtDate(day)} · ${SITE.title}`,
  url: new URL(Astro.url.pathname, SITE.url).href,
  description: `Every story filed on ${fmtDate(day)}.`,
  isPartOf: { '@type': 'WebSite', name: SITE.title, url: SITE.url },
};
---

<Base title={`Editions · ${fmtDate(day)}`} description={`Every story filed by ${SITE.title} on ${fmtDate(day)}.`} schema={schema}>
  <section class="day">
    <div class="container">
      <header class="page-head">
        <Kicker label="Filing day" text={`${entries.length} ${entries.length === 1 ? 'story' : 'stories'}`} />
        <h1>{fmtDate(day)}</h1>
        <p class="page-head__meta">
          <span>{groups.filter((group) => group.stories.length > 0).length} editions filed</span>
          <span>{sourceCount} sources linked</span>
          <span>{channelCount} channels</span>
          <span>All times IST</span>
        </p>
      </header>

      {lead && (
        <section class="day-lead" aria-labelledby="day-lead-heading">
          <p class="day-lead__label">
            <span>Lead</span>
            <span>{EDITIONS[lead.data.edition].label}</span>
          </p>
          <h2 id="day-lead-heading"><a href={`/story/${lead.id}`}>{lead.data.title}</a></h2>
          <p class="day-lead__dek">{lead.data.dek}</p>
          <p class="day-lead__meta">
            <a href={`/channel/${lead.data.channel}`}>{CHANNELS[lead.data.channel].label}</a>
            <span>{fmtTime(lead.data.publishedAt)} IST</span>
            <span>{lead.data.readingTime} min read</span>
          </p>
          <a class="link-arrow" href={`/story/${lead.id}`}>
            Read the story
            <span aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {groups.map((group) => (
        <section class="edition-group" aria-labelledby={`edition-${group.slug}`}>
          <SectionHead
            title={group.label}
            id={`edition-${group.slug}`}
            label={`Cut-off ${group.cut} IST · ${group.window}`}
          />
          {group.stories.length > 0 ? (
            <ol class="rows">
              {group.stories.map((story, rowIndex) => (
                <StoryRow story={story} index={rowIndex + 1} />
              ))}
            </ol>
          ) : (
            <p class="empty-note">Nothing filed for this edition.</p>
          )}
        </section>
      ))}

      <nav class="day-nav" aria-label="Other filing days">
        {older ? (
          <a class="link-arrow" href={`/editions/${older}`}>
            <span aria-hidden="true">←</span>
            {fmtDate(older)}
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a class="link-arrow" href={`/editions/${newer}`}>
            {fmtDate(newer)}
            <span aria-hidden="true">→</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    </div>
  </section>
</Base>

<style>
  .day {
    padding-bottom: var(--section-y);
  }

  .day-lead {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    padding-block: var(--space-5) clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .day-lead__label {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    max-width: none;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .day-lead__label span:first-child {
    color: var(--accent);
  }

  .day-lead h2 {
    font-size: clamp(1.9rem, 2.4vw + 1rem, 3.25rem);
    line-height: 1.06;
    max-width: 22ch;
  }

  .day-lead h2 a {
    transition: color var(--duration) var(--ease);
  }

  .day-lead h2 a:hover {
    color: var(--accent);
  }

  .day-lead__dek {
    max-width: 58ch;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .day-lead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    max-width: none;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .day-lead__meta a {
    border-bottom: 1px solid var(--line);
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .day-lead__meta a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .edition-group + .edition-group {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .day-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-5);
    padding-top: var(--space-5);
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }
</style>
