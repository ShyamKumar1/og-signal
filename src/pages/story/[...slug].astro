---
/**
 * Story — one filed story.
 * Static paths from the published `stories` collection; drafts are excluded.
 * Adds a reading-progress hairline, a sticky h2 table of contents, timeline,
 * sources card, related rows, and NewsArticle JSON-LD.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import SectionHead from '../../components/SectionHead.astro';
import StoryRow from '../../components/StoryRow.astro';
import { CHANNELS, SITE } from '../../lib/site';
import { fmtDate, fmtStamp, fmtTime, hostOf, pad } from '../../lib/format';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories
    .filter((story) => !story.data.draft)
    .map((story) => ({ params: { slug: story.id }, props: { story } }));
}

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { Content, headings } = await render(story);
const channel = CHANNELS[story.data.channel];
const toc = headings.filter((heading) => heading.depth === 2);

const allStories = await getCollection('stories');
const related = allStories
  .filter((entry) => !entry.data.draft && entry.id !== story.id && entry.data.channel === story.data.channel)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const stamp = fmtStamp(story.data.verifiedAt ?? story.data.publishedAt);
const verifiedLabel = story.data.verifiedAt ? `Verified ${stamp}` : `Published ${stamp}`;
const chipLabel = story.data.verifiedAt
  ? 'sources verified'
  : story.data.claimsChecked > 0
    ? `${story.data.claimsChecked} claims checked`
    : 'sources linked';

const footnote = story.data.verifiedAt
  ? `${story.data.claimsChecked} claims checked · verified ${fmtStamp(story.data.verifiedAt)}`
  : `${story.data.sources.length} sources listed · verification stamp pending`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: story.data.title,
  description: story.data.dek,
  datePublished: story.data.publishedAt.toISOString(),
  dateModified: (story.data.updatedAt ?? story.data.publishedAt).toISOString(),
  articleSection: channel.label,
  timeRequired: `PT${story.data.readingTime}M`,
  isAccessibleForFree: true,
  inLanguage: 'en-IN',
  mainEntityOfPage: new URL(Astro.url.pathname, SITE.url).href,
  author: { '@type': 'Organization', name: SITE.owner, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.owner, url: SITE.url },
  citation: story.data.sources.map((source) => ({
    '@type': 'CreativeWork',
    name: source.title,
    url: source.url,
    publisher: source.publisher,
    ...(source.published ? { datePublished: source.published } : {}),
  })),
};
---

<Base title={story.data.title} description={story.data.dek} schema={schema} slug={story.id}>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <article class="story" data-article>
    <div class="container">
      <div class="article-grid">
        <aside class="toc" aria-label="On this page" data-pagefind-ignore>
          {toc.length > 1 && (
            <nav class="toc__inner">
              <p class="toc__title">On this page</p>
              <ol>
                {toc.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
        </aside>

        <div class="article-body">
          <header class="article-head">
            <p class="article-kicker">
              <a href={`/channel/${channel.slug}`} data-pagefind-meta="channel">{channel.short}</a>
              <span>{fmtDate(story.data.publishedAt)}</span>
              <span>{fmtTime(story.data.publishedAt)} IST</span>
              <span>{story.data.readingTime} min read</span>
            </p>

            <h1 data-pagefind-meta="title">{story.data.title}</h1>
            <p class="article-dek">{story.data.dek}</p>

            <div class="byline">
              <span>{SITE.title} Desk</span>
              <span>{verifiedLabel}</span>
              <time class="visually-hidden" datetime={story.data.publishedAt.toISOString()} data-pagefind-meta="date">
                {fmtDate(story.data.publishedAt)}
              </time>
              <Chip label={chipLabel} tone={story.data.verifiedAt ? 'sage' : 'line'} />
            </div>
          </header>

          <div class="prose" data-pagefind-body>
            <Content />
          </div>

          {story.data.timeline.length > 0 && (
            <section class="story-timeline" aria-labelledby="timeline-heading" data-pagefind-ignore>
              <SectionHead title="What changed" id="timeline-heading" />
              <ol>
                {story.data.timeline.map((item) => (
                  <li>
                    <span class="story-timeline__at">{item.at}</span>
                    <span class="story-timeline__note">{item.note}</span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          <section class="story-sources" aria-labelledby="sources-heading" data-pagefind-ignore>
            <SectionHead title="Sources" id="sources-heading" />
            <div class="source-card">
              <ol>
                {story.data.sources.map((source, index) => (
                  <li>
                    <a href={source.url} target="_blank" rel="noopener noreferrer">
                      <span class="source-card__index" aria-hidden="true">{pad(index + 1)}</span>
                      <span class="source-card__main">
                        <span class="source-card__title">{source.title}</span>
                        <span class="source-card__meta">
                          {source.publisher} · {hostOf(source.url)}
                          {source.published ? ` · ${source.published}` : ''}
                        </span>
                      </span>
                      <span class="source-card__arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ol>
              <p class="source-card__foot">{footnote}</p>
            </div>
          </section>
        </div>
      </div>

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-heading" data-pagefind-ignore>
          <SectionHead title={`More in ${channel.label}`} id="related-heading" />
          <ol class="rows">
            {related.map((entry, index) => (
              <StoryRow story={entry} index={index + 1} showDek={false} />
            ))}
          </ol>
        </section>
      )}
    </div>
  </article>
</Base>

<script>
  const bound = window as Window & { __ogReading?: boolean };

  const updateProgress = () => {
    const article = document.querySelector<HTMLElement>('[data-article]');
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    if (!article || !bar) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const progress = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 1;
    bar.style.transform = `scaleX(${progress})`;
  };

  if (!bound.__ogReading) {
    bound.__ogReading = true;
    document.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
  }

  document.addEventListener('astro:page-load', updateProgress);
  if (document.readyState !== 'loading') updateProgress();
</script>

<style>
  .progress {
    position: fixed;
    top: var(--header-h-sm);
    left: 0;
    right: 0;
    height: 2px;
    z-index: 90;
    pointer-events: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
    padding-block: clamp(40px, 6vw, 80px) clamp(40px, 5vw, 64px);
  }

  .article-head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: clamp(28px, 4vw, 48px);
    margin-bottom: clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
  }

  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    max-width: none;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .article-kicker a {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
    transition: border-color var(--duration) var(--ease);
  }

  .article-kicker a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .article-head h1 {
    font-size: clamp(2.2rem, 2.6vw + 1rem, 4.25rem);
    line-height: 1.03;
    max-width: 20ch;
    overflow-wrap: break-word;
    text-wrap: balance;
    min-width: 0;
  }

  .article-dek {
    max-width: 58ch;
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .toc {
    display: none;
  }

  .toc__inner {
    position: sticky;
    top: calc(var(--header-h-sm) + 32px);
    display: grid;
    gap: 10px;
    padding-top: 6px;
  }

  .toc__title {
    max-width: none;
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc ol {
    display: grid;
    gap: 2px;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 7px 0 7px 14px;
    color: var(--ink-mute);
    font-size: 0.8125rem;
    line-height: 1.4;
    transition: color var(--duration) var(--ease);
  }

  .toc a:hover {
    color: var(--ink);
  }

  .story-timeline {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .story-timeline ol {
    display: grid;
    gap: var(--space-5);
    padding-left: var(--space-5);
    border-left: 1px dashed var(--line);
    max-width: var(--measure);
  }

  .story-timeline li {
    display: grid;
    gap: 3px;
  }

  .story-timeline__at {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .story-timeline__note {
    color: var(--ink-soft);
    font-size: var(--text-ui);
    line-height: 1.5;
  }

  .story-sources {
    margin-top: clamp(48px, 6vw, 80px);
  }

  .source-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .source-card ol {
    border-top: 0;
  }

  .source-card li + li {
    border-top: 1px solid var(--line-soft);
  }

  .source-card a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 24px;
    gap: var(--space-3);
    align-items: baseline;
    padding: 14px 20px;
    transition: background-color var(--duration) var(--ease);
  }

  .source-card a:hover {
    background: var(--paper-band);
  }

  .source-card__index {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
  }

  .source-card__main {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .source-card__title {
    font-size: var(--text-ui);
    line-height: 1.4;
    color: var(--ink);
  }

  .source-card a:hover .source-card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .source-card__meta {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .source-card__arrow {
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    justify-self: end;
  }

  .source-card__foot {
    max-width: none;
    padding: 12px 20px;
    border-top: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink-mute);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related {
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  @media (min-width: 1180px) {
    .article-grid {
      grid-template-columns: var(--margin-col) minmax(0, var(--measure));
      gap: clamp(32px, 4vw, 64px);
      align-items: start;
    }

    .toc {
      display: block;
    }
  }
</style>
