---
/**
 * EditionConsole — the live desk table in the hero.
 * Props: headline (e.g. "Today · Morning edition"), editions ({ short, label, cut, count, current? }[]),
 * sources (unique source count), status (short chip text), statusTone? (-line | cream | sage).
 * Every value is computed from the collection by the page; nothing here is hard-coded copy.
 */
import Chip from './Chip.astro';

interface Props {
  headline: string;
  editions: { short: string; label: string; cut: string; count: number; current?: boolean }[];
  sources: number;
  status: string;
  statusTone?: 'line' | 'cream' | 'sage';
}

const { headline, editions, sources, status, statusTone = 'sage' } = Astro.props;
---

<aside class="console card" aria-label="Edition console">
  <div class="console__head">
    <p class="console__title">{headline}</p>
    <p class="console__zone">IST</p>
  </div>

  <table class="console__table">
    <caption class="visually-hidden">Editions filed today, with story counts and cut-off times</caption>
    <thead>
      <tr>
        <th scope="col">Edition</th>
        <th scope="col">Stories</th>
        <th scope="col">Cut-off</th>
      </tr>
    </thead>
    <tbody>
      {editions.map((edition) => (
        <tr class:list={[{ 'is-current': edition.current }]}>
          <th scope="row">
            <span class="console__short">{edition.short}</span>
            <span class="console__label">{edition.label}</span>
          </th>
          <td>{edition.count}</td>
          <td>{edition.cut}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="console__foot">
    <p class="console__sources">{sources} sources linked</p>
    <Chip label={status} tone={statusTone} />
  </div>
</aside>

<style>
  .console {
    width: 100%;
    overflow: hidden;
    container-type: inline-size;
  }

  .console__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 16px 22px;
    border-bottom: 1px solid var(--line);
  }

  .console__title,
  .console__zone {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    max-width: none;
  }

  .console__title {
    color: var(--ink);
  }

  .console__zone {
    color: var(--ink-mute);
  }

  .console__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .console__table th,
  .console__table td {
    padding: 14px 22px;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid var(--line-soft);
  }

  .console__table thead th {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-block: 10px;
    background: var(--paper);
  }

  .console__table thead th:not(:first-child),
  .console__table tbody td {
    text-align: right;
    white-space: nowrap;
  }

  .console__table tbody th {
    font-weight: 400;
  }

  .console__short {
    display: none;
  }

  .console__label {
    color: var(--ink-soft);
  }

  .console__table tbody td {
    color: var(--ink-soft);
  }

  .console__table tr.is-current th,
  .console__table tr.is-current td {
    background: var(--paper-band);
    color: var(--ink);
  }

  .console__table tr.is-current .console__short {
    display: inline;
    margin-right: 8px;
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .console__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 14px 22px;
    border-top: 1px solid var(--line);
  }

  .console__sources {
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  @container (max-width: 380px) {
    .console__head,
    .console__foot {
      padding-inline: 16px;
    }

    .console__table th,
    .console__table td {
      padding-inline: 16px;
    }

    .console__table thead th:nth-child(3),
    .console__table tbody td:nth-child(3) {
      display: none;
    }
  }
</style>
