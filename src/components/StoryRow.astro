---
/**
 * StoryRow — one hairline-divided index row for a story.
 * Props: story (published collection entry), index (1-based), showDek? (default true).
 * Renders an <li>; place inside <ol class="rows">.
 */
import type { CollectionEntry } from 'astro:content';
import { CHANNELS } from '../lib/site';
import { fmtTime, pad } from '../lib/format';

interface Props {
  story: CollectionEntry<'stories'>;
  index: number;
  showDek?: boolean;
}

const { story, index, showDek = true } = Astro.props;
const channel = CHANNELS[story.data.channel];
---

<li class="story-row">
  <a class="story-row__link" href={`/story/${story.id}`}>
    <span class="story-row__index" aria-hidden="true">{pad(index)}</span>

    <span class="story-row__main">
      <span class="story-row__top">
        <span class={`chip chip--line`}>{channel.short}</span>
        <span class="story-row__title">{story.data.title}</span>
      </span>
      {showDek && <span class="story-row__dek">{story.data.dek}</span>}
    </span>

    <span class="story-row__meta">
      <time datetime={story.data.publishedAt.toISOString()}>{fmtTime(story.data.publishedAt)} IST</time>
      <span>{story.data.readingTime} min</span>
    </span>
  </a>
</li>

<style>
  .story-row__link {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 120px;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-5);
    transition: background-color var(--duration) var(--ease);
  }

  .story-row__link:hover {
    background: color-mix(in srgb, var(--paper-band) 60%, transparent);
  }

  .story-row__index {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    padding-top: 5px;
  }

  .story-row__main {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .story-row__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .story-row__title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.35vw + 1.05rem, 1.375rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    overflow-wrap: break-word;
    min-width: 0;
  }

  .story-row__link:hover .story-row__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .story-row__dek {
    max-width: 62ch;
    font-size: var(--text-ui);
    line-height: 1.5;
    color: var(--ink-mute);
  }

  .story-row__meta {
    display: grid;
    justify-items: end;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    padding-top: 3px;
    text-align: right;
  }

  @media (max-width: 720px) {
    .story-row__link {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .story-row__meta {
      grid-column: 2;
      justify-items: start;
      display: flex;
      gap: 12px;
      padding-top: 0;
    }
  }
</style>
