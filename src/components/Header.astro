---
/**
 * Header — floating transparent nav that condenses on scroll.
 * No props. Reads CHANNELS for the channels menu and Astro.url for the active link.
 * Mobile drawer traps focus, closes on Escape, and returns focus to the trigger.
 */
import { CHANNEL_LIST } from '../lib/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const navLinks = [
  { href: '/', label: 'Today' },
  { href: '/editions', label: 'Editions' },
] as const;
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="OG Signal, home">
      <span class="wordmark__mark" aria-hidden="true"></span>
      <span class="wordmark__text">OG Signal</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
      <details class="nav-drop" data-drop>
        <summary>
          Channels
          <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </summary>
        <div class="nav-drop__panel">
          {CHANNEL_LIST.map((channel) => (
            <a href={`/channel/${channel.slug}`}>
              <span class="nav-drop__name">{channel.label}</span>
              <span class="nav-drop__blurb">{channel.blurb}</span>
            </a>
          ))}
        </div>
      </details>
      <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
        <svg class="theme-toggle__sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <svg class="theme-toggle__moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M13 10.2A5.6 5.6 0 016.1 3a5.7 5.7 0 106.9 7.2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
      </button>

      <a class="btn btn--primary header-cta" href="/rss.xml">
        Subscribe
        <span aria-hidden="true">→</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-drawer"
        aria-label="Open menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="site-drawer" data-drawer data-pagefind-ignore hidden>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="drawer__top">
      <span class="wordmark__text">OG Signal</span>
      <button class="drawer__close" type="button" data-drawer-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>

    <nav class="drawer__nav" aria-label="Mobile">
      <a href="/">Today</a>
      <a href="/editions">Editions</a>
      <a href="/about">About</a>
    </nav>

    <p class="rule-label drawer__label">Channels</p>
    <ul class="drawer__channels">
      {CHANNEL_LIST.map((channel) => (
        <li>
          <a href={`/channel/${channel.slug}`}>
            <span>{channel.label}</span>
            <span class="drawer__count">{channel.short}</span>
          </a>
        </li>
      ))}
    </ul>

    <a class="btn btn--primary drawer__cta" href="/rss.xml">
      Subscribe
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .site-header.is-stuck {
    height: var(--header-h-sm);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    width: 100%;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
  }

  .wordmark__mark {
    position: relative;
    width: 22px;
    height: 22px;
    flex: none;
  }

  .wordmark__mark::before,
  .wordmark__mark::after {
    content: "";
    position: absolute;
    width: 13px;
    height: 13px;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
  }

  .wordmark__mark::before {
    left: 0;
    top: 0;
  }

  .wordmark__mark::after {
    right: 0;
    bottom: 0;
    background: var(--paper);
  }

  .wordmark__text {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-desktop > a,
  .nav-drop summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--ink-soft);
    transition: color var(--duration) var(--ease);
  }

  .nav-desktop > a:hover,
  .nav-drop summary:hover,
  .nav-desktop > a[aria-current="page"] {
    color: var(--ink);
  }

  .nav-drop {
    position: relative;
  }

  .nav-drop summary {
    cursor: pointer;
    list-style: none;
  }

  .nav-drop summary::-webkit-details-marker {
    display: none;
  }

  .nav-drop[open] summary {
    color: var(--ink);
  }

  .nav-drop[open] summary svg {
    transform: rotate(180deg);
  }

  .nav-drop summary svg {
    transition: transform var(--duration) var(--ease);
  }

  .nav-drop__panel {
    position: absolute;
    top: calc(100% + 4px);
    left: -20px;
    width: 320px;
    padding: 8px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-inner);
    display: grid;
    gap: 2px;
  }

  .nav-drop__panel a {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    min-height: 44px;
    border-radius: var(--radius-small);
    transition: background-color var(--duration) var(--ease);
  }

  .nav-drop__panel a:hover {
    background: var(--paper-band);
  }

  .nav-drop__name {
    font-family: var(--font-body);
    font-size: var(--text-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
  }

  .nav-drop__blurb {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-mute);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--ink-soft);
    transition: color var(--duration) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
  }

  .theme-toggle__moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__moon {
    display: block;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--duration) var(--ease);
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ---------- drawer ---------- */

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 900;
    background: var(--paper);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }

  .drawer.is-open {
    opacity: 1;
  }

  .drawer__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: min(420px, 100%);
    height: 100%;
    margin-left: auto;
    padding: 18px var(--gutter) var(--space-7);
    background: var(--paper);
    border-left: 1px solid var(--line);
    overflow-y: auto;
    transform: translateX(12px);
    transition: transform var(--duration) var(--ease);
  }

  .drawer.is-open .drawer__panel {
    transform: none;
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink-soft);
  }

  .drawer__nav {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .drawer__nav a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .drawer__label {
    color: var(--ink-mute);
  }

  .drawer__channels a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    font-size: var(--text-ui);
  }

  .drawer__count {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .drawer__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 980px) {
    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 640px) {
    .header-cta {
      display: none;
    }

    .header-actions {
      gap: 2px;
    }
  }
</style>

<script>
  type Drawer = HTMLElement;

  const bound = window as Window & { __ogSignalHeader?: boolean };

  const initHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header || header.dataset.ready === 'true') return;
    header.dataset.ready = 'true';

    const toggleStuck = () => {
      header.classList.toggle('is-stuck', window.scrollY > 40);
    };
    toggleStuck();

    if (!bound.__ogSignalHeader) {
      bound.__ogSignalHeader = true;
      document.addEventListener('scroll', () => {
        document.querySelector('[data-site-header]')?.classList.toggle('is-stuck', window.scrollY > 40);
      }, { passive: true });

      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        const drop = document.querySelector<HTMLDetailsElement>('[data-drop]');
        if (drop?.open && !drop.contains(target)) drop.open = false;
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const drop = document.querySelector<HTMLDetailsElement>('[data-drop]');
        if (drop?.open) drop.open = false;
      });
    }

    const root = document.documentElement;
    const themeButton = header.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    const syncTheme = () => {
      const dark = root.dataset.theme === 'dark';
      themeButton?.setAttribute('aria-pressed', String(dark));
      themeButton?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    };
    syncTheme();

    themeButton?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('og-theme', next);
      } catch {
        /* storage can be blocked; the toggle still works for this page */
      }
      syncTheme();
    });

    const drawer = document.querySelector<Drawer>('[data-drawer]');
    const menuButton = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const closeButton = drawer?.querySelector<HTMLButtonElement>('[data-drawer-close]');
    if (!drawer || !menuButton) return;

    const focusables = () =>
      Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.offsetParent !== null,
      );

    const openDrawer = () => {
      drawer.hidden = false;
      drawer.classList.add('is-open');
      menuButton.setAttribute('aria-expanded', 'true');
      menuButton.setAttribute('aria-label', 'Close menu');
      root.classList.add('is-locked');
      window.requestAnimationFrame(() => closeButton?.focus());
    };

    const closeDrawer = () => {
      drawer.classList.remove('is-open');
      drawer.hidden = true;
      menuButton.setAttribute('aria-expanded', 'false');
      menuButton.setAttribute('aria-label', 'Open menu');
      root.classList.remove('is-locked');
      menuButton.focus();
    };

    menuButton.addEventListener('click', () => {
      if (drawer.hidden) openDrawer();
      else closeDrawer();
    });
    closeButton?.addEventListener('click', closeDrawer);

    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) closeDrawer();
    });

    drawer.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    drawer.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        drawer.hidden = true;
        menuButton.setAttribute('aria-expanded', 'false');
        root.classList.remove('is-locked');
      });
    });
  };

  document.addEventListener('astro:page-load', initHeader);
  if (document.readyState !== 'loading') initHeader();
  else document.addEventListener('DOMContentLoaded', initHeader);
</script>
