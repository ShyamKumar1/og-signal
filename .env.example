# Alert channel for the OG Signal wire.
# Copy to .env and fill in. .env is gitignored.

# Telegram (default when a bot token exists). The bot token and home channel
# already live in ~/.hermes/.env on this machine, so notify.mjs picks them up
# with no copy needed. Override only if you want a different chat.
# WHATSAPP_PROVIDER=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=662877576

# WhatsApp via callmebot (free, personal number): send "I allow callmebot to
# send me messages" to +34 644 51 95 23, then put the key it replies with here.
# WHATSAPP_PROVIDER=callmebot
# WHATSAPP_CALLMEBOT_KEY=
# WHATSAPP_TO=+91

# Meta Cloud API alternative
# WHATSAPP_PROVIDER=cloud
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en

# Twilio alternative
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
