# WhatsApp alerts for the OG Signal wire.
# Copy to .env and fill in one provider. .env is gitignored.

# callmebot (free, personal number): send "I allow callmebot to send me messages"
# to +34 644 51 95 23 on WhatsApp, then put the key it replies with here.
WHATSAPP_PROVIDER=callmebot
WHATSAPP_CALLMEBOT_KEY=
WHATSAPP_TO=+91

# Meta Cloud API alternative
# WHATSAPP_PROVIDER=cloud
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en

# Twilio alternative
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
